generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  OWNER
  PHARMACIST
  DRIVER
  ADMIN
}

enum PharmacyApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
}

enum PharmacyOperationalStatus {
  OPEN
  CLOSED
}

enum PharmacyMemberRole {
  OWNER
  PHARMACIST
}

enum PharmacyMemberStatus {
  ACTIVE
  INACTIVE
}

enum DriverApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
}

enum DriverAvailabilityStatus {
  OFFLINE
  AVAILABLE
  BUSY
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum SessionType {
  CUSTOMER
  INTERNAL
}

enum OrderStatus {
  PENDING
  PHARMACY_REVIEWING
  PHARMACY_CONFIRMED
  CUSTOMER_CONFIRMATION_PENDING
  PAYMENT_PENDING
  PAID
  PHARMACY_PREPARING
  READY_FOR_PICKUP
  IN_DELIVERY
  DELIVERED
  COMPLETED
  CLOSED
  EXCEPTION
}

enum OrderItemStatus {
  PENDING
  AVAILABLE
  UNAVAILABLE
}

enum PharmacyAssignmentStatus {
  OFFERED
  ACTIVE
  REJECTED
  EXPIRED
  CANCELLED
  COMPLETED
  TRANSFERRED
}

enum PrescriptionStatus {
  PENDING_UPLOAD
  UPLOADED
  UNDER_REVIEW
  ACCEPTED
  REUPLOAD_REQUIRED
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PROCESSING
  REQUIRES_ACTION
  PAID
  FAILED
  EXPIRED
  UNKNOWN
  CANCELLED
  REFUND_PENDING
  REFUNDED
  PARTIALLY_REFUNDED
}

enum DeliveryStatus {
  NOT_STARTED
  SEARCHING_FOR_DRIVER
  DRIVER_ASSIGNED
  GOING_TO_PHARMACY
  ARRIVED_AT_PHARMACY
  HANDOVER_PENDING
  PICKED_UP
  ON_THE_WAY
  ARRIVING_SOON
  OTP_PENDING
  DELIVERED
  CASH_PENDING
  COMPLETED
  EXCEPTION
}

enum DeliveryOfferStatus {
  OFFERED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum DeliveryOtpStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  REVOKED
  LOCKED
}

enum CashCollectionStatus {
  NOT_DUE
  DUE
  RECEIVED
  UNPAID
  PARTIALLY_PAID
  DISPUTED
}

enum DeliveryExceptionStatus {
  OPEN
  DRIVER_CONTACTED
  PHARMACY_RETRIEVAL_REQUIRED
  CUSTOMER_CONTACT_REQUIRED
  ADMIN_REVIEW
  RESOLVED
}

enum CustodianType {
  DRIVER
  PHARMACY
  OTHER
}

enum ConsultationStatus {
  REQUESTED
  ASSIGNED
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  COMPLETED
  CANCELLED
  EXPIRED
}

model User {
  id        String   @id @default(uuid())
  phone     String   @unique
  name      String?
  role      UserRole @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacyMemberships PharmacyMember[]
  addresses           Address[]
  sessions            AuthSession[]
  orders              Order[]

  prescriptionVersionsUploaded PrescriptionVersion[] @relation("PrescriptionVersionUploader")
  prescriptionVersionsReviewed PrescriptionVersion[] @relation("PrescriptionVersionReviewer")

  driver             Driver?
  deliveryExceptions DeliveryException[]
  consultationsAsCustomer     Consultation[]                  @relation("CustomerConsultations")
  consultationsAsPharmacist   Consultation[]                  @relation("PharmacistConsultations")
  assignedByHistory           ConsultationAssignmentHistory[] @relation("AssignmentAssigner")
  chatMessagesSent            ChatMessage[]
  notifications               Notification[]
  auditLogs                   AuditLog[]                      @relation("AuditActor")

  @@index([role])
}

model OtpChallenge {
  id         String    @id @default(uuid())
  phoneHash  String
  activeKey  String?   @unique
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phoneHash, createdAt])
  @@index([expiresAt])
}

model AuthSession {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      SessionType
  tokenHash String      @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId, type])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Pharmacy {
  id                String                    @id @default(uuid())
  name              String
  phone             String?
  address           String?
  latitude          Decimal                   @db.Decimal(10, 7)
  longitude         Decimal                   @db.Decimal(10, 7)
  approvalStatus    PharmacyApprovalStatus    @default(PENDING_APPROVAL)
  operationalStatus PharmacyOperationalStatus @default(CLOSED)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  members             PharmacyMember[]
  orders              Order[]
  pharmacyAssignments PharmacyAssignment[]
  pricingOriginOrders Order[]              @relation("OrderPricingOriginPharmacy")
  consultations       Consultation[]

  @@index([approvalStatus])
  @@index([operationalStatus])
  @@index([approvalStatus, operationalStatus])
}

model PharmacyMember {
  id         String               @id @default(uuid())
  pharmacyId String
  pharmacy   Pharmacy             @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       PharmacyMemberRole
  status     PharmacyMemberStatus @default(ACTIVE)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([pharmacyId, userId])
  @@index([pharmacyId, role, status])
  @@index([userId, role, status])
}

model Driver {
  id             String                   @id @default(uuid())
  userId         String                   @unique
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvalStatus DriverApprovalStatus     @default(PENDING_APPROVAL)
  availability   DriverAvailabilityStatus @default(OFFLINE)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  deliveries         Delivery[]
  deliveryOffers     DeliveryOffer[]
  currentLocation    DriverCurrentLocation?
  locationHistory    DriverLocationHistory[]
  deliveryExceptions DeliveryException[]

  @@index([approvalStatus])
  @@index([availability])
  @@index([approvalStatus, availability])
}

model Address {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AddressType
  label     String?
  address   String
  latitude  Decimal     @db.Decimal(10, 7)
  longitude Decimal     @db.Decimal(10, 7)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
}

model Order {
  id                          String      @id @default(uuid())
  customerId                  String
  customer                    User        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  pharmacyId                  String
  pharmacy                    Pharmacy    @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)
  status                      OrderStatus @default(PENDING)
  deliveryAddress             String
  deliveryLatitude            Decimal     @db.Decimal(10, 7)
  deliveryLongitude           Decimal     @db.Decimal(10, 7)
  medicineSubtotal            Decimal?    @db.Decimal(12, 2)
  deliveryFee                 Decimal?    @db.Decimal(12, 2)
  totalAmount                 Decimal?    @db.Decimal(12, 2)
  currency                    String      @default("SYP") @db.VarChar(3)
  pricingConfigurationVersion String?
  pricingStrategy             String?
  pricingConfigurationRef     String?
  pricingOriginPharmacyId     String?
  pricingOriginPharmacy       Pharmacy?   @relation("OrderPricingOriginPharmacy", fields: [pricingOriginPharmacyId], references: [id], onDelete: Restrict)
  pricingOriginLatitude       Decimal?    @db.Decimal(10, 7)
  pricingOriginLongitude      Decimal?    @db.Decimal(10, 7)
  pricingDistance             Decimal?
  pricingDistanceUnit         String?
  pricingCalculatedAt         DateTime?
  pricingQuoteAt              DateTime?
  pricingSupported            Boolean?
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt

  items        OrderItem[]
  assignments  PharmacyAssignment[]
  prescription Prescription?
  payments     Payment[]
  deliveries   Delivery[]
  stateHistory OrderStateHistory[]

  @@index([customerId, createdAt])
  @@index([pharmacyId, status])
  @@index([status, createdAt])
}

model OrderItem {
  id           String          @id @default(uuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  medicineName String
  quantity     Int
  status       OrderItemStatus @default(PENDING)
  unitPrice    Decimal?        @db.Decimal(12, 2)
  totalPrice   Decimal?        @db.Decimal(12, 2)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([orderId, status])
}

model PharmacyAssignment {
  id            String                   @id @default(uuid())
  orderId       String
  order         Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pharmacyId    String
  pharmacy      Pharmacy                 @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)
  status        PharmacyAssignmentStatus @default(OFFERED)
  offeredAt     DateTime                 @default(now())
  activatedAt   DateTime?
  rejectedAt    DateTime?
  expiredAt     DateTime?
  cancelledAt   DateTime?
  completedAt   DateTime?
  transferredAt DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([orderId, status])
  @@index([pharmacyId, status])
  @@index([status, createdAt])
}

model Prescription {
  id        String             @id @default(uuid())
  orderId   String             @unique
  order     Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    PrescriptionStatus @default(PENDING_UPLOAD)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  versions PrescriptionVersion[]

  @@index([status])
}

model PrescriptionVersion {
  id               String       @id @default(uuid())
  prescriptionId   String
  prescription     Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  version          Int
  storageKey       String
  originalFileName String
  mimeType         String
  sizeBytes        Int
  uploadedByUserId String
  uploadedByUser   User         @relation("PrescriptionVersionUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  uploadedAt       DateTime     @default(now())

  status           PrescriptionStatus @default(UPLOADED)
  rejectionReason  String?
  reviewNotes      String?
  reviewedByUserId String?
  reviewedByUser   User?              @relation("PrescriptionVersionReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?

  @@unique([prescriptionId, version])
  @@index([prescriptionId])
  @@index([uploadedByUserId])
  @@index([reviewedByUserId])
}

model Payment {
  id                    String        @id @default(uuid())
  orderId               String
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider              String        @default("SHAM_CASH")
  providerTransactionId String?
  idempotencyKey        String
  amount                Decimal       @db.Decimal(12, 2)
  currency              String        @default("SYP") @db.VarChar(3)
  status                PaymentStatus @default(PENDING)
  expiresAt             DateTime?
  paidAt                DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  events PaymentEvent[]

  @@unique([provider, idempotencyKey])
  @@index([orderId, status])
  @@index([providerTransactionId])
  @@index([status, createdAt])
}

model PaymentEvent {
  id              String   @id @default(uuid())
  paymentId       String
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  providerEventId String   @unique
  eventType       String
  payload         Json
  createdAt       DateTime @default(now())

  @@index([paymentId])
}

model Delivery {
  id               String         @id @default(uuid())
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  driverId         String?
  driver           Driver?        @relation(fields: [driverId], references: [id], onDelete: SetNull)
  status           DeliveryStatus @default(NOT_STARTED)
  pickupAddress    String
  pickupLatitude   Decimal        @db.Decimal(10, 7)
  pickupLongitude  Decimal        @db.Decimal(10, 7)
  dropoffAddress   String
  dropoffLatitude  Decimal        @db.Decimal(10, 7)
  dropoffLongitude Decimal        @db.Decimal(10, 7)
  startedAt        DateTime?
  pickedUpAt       DateTime?
  deliveredAt      DateTime?
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  offers           DeliveryOffer[]
  currentLocations DriverCurrentLocation[]
  locationHistory  DriverLocationHistory[]
  otps             DeliveryOtp[]
  cashCollection   CashCollection?
  exception        DeliveryException?
  stateHistory     DeliveryStateHistory[]

  @@index([orderId])
  @@index([driverId, status])
  @@index([status, createdAt])
}

model DeliveryOffer {
  id            String              @id @default(uuid())
  deliveryId    String
  delivery      Delivery            @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  driverId      String
  driver        Driver              @relation(fields: [driverId], references: [id], onDelete: Cascade)
  status        DeliveryOfferStatus @default(OFFERED)
  offeredAt     DateTime            @default(now())
  expiresAt     DateTime?
  acceptedAt    DateTime?
  rejectedAt    DateTime?
  failureReason String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([deliveryId, status])
  @@index([driverId, status])
}

model DriverCurrentLocation {
  id         String    @id @default(uuid())
  driverId   String    @unique
  driver     Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  deliveryId String?
  delivery   Delivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  latitude   Decimal   @db.Decimal(10, 7)
  longitude  Decimal   @db.Decimal(10, 7)
  heading    Decimal?  @db.Decimal(5, 2)
  speed      Decimal?  @db.Decimal(5, 2)
  recordedAt DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([deliveryId])
  @@index([recordedAt])
}

model DriverLocationHistory {
  id         String    @id @default(uuid())
  driverId   String
  driver     Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  deliveryId String?
  delivery   Delivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  latitude   Decimal   @db.Decimal(10, 7)
  longitude  Decimal   @db.Decimal(10, 7)
  heading    Decimal?  @db.Decimal(5, 2)
  speed      Decimal?  @db.Decimal(5, 2)
  recordedAt DateTime  @default(now())

  @@index([driverId, recordedAt])
  @@index([deliveryId, recordedAt])
}

model DeliveryOtp {
  id           String            @id @default(uuid())
  deliveryId   String
  delivery     Delivery          @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  otpHash      String
  status       DeliveryOtpStatus @default(ACTIVE)
  expiresAt    DateTime
  attemptCount Int               @default(0)
  maxAttempts  Int               @default(3)
  consumedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([deliveryId, status])
  @@index([expiresAt])
}

model CashCollection {
  id                 String               @id @default(uuid())
  deliveryId         String               @unique
  delivery           Delivery             @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  expectedAmount     Decimal              @db.Decimal(12, 2)
  receivedAmount     Decimal?             @db.Decimal(12, 2)
  currency           String               @default("SYP") @db.VarChar(3)
  status             CashCollectionStatus @default(NOT_DUE)
  verifiedByUserId   String?
  verificationMethod String?
  receivedAt         DateTime?
  reason             String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([deliveryId, status])
  @@index([status, createdAt])
}

model DeliveryException {
  id               String                  @id @default(uuid())
  deliveryId       String                  @unique
  delivery         Delivery                @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  driverId         String
  driver           Driver                  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  status           DeliveryExceptionStatus @default(OPEN)
  currentCustodian CustodianType           @default(DRIVER)
  openedAt         DateTime                @default(now())
  reason           String
  notes            String?
  resolution       String?
  resolvedByUserId String?
  resolvedByUser   User?                   @relation(fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  resolvedAt       DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([status])
  @@index([deliveryId])
  @@index([driverId])
}

model OrderStateHistory {
  id            String      @id @default(uuid())
  orderId       String
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  previousState String?
  newState      OrderStatus
  actorId       String?
  reason        String?
  metadata      Json?
  timestamp     DateTime    @default(now())

  @@index([orderId, timestamp])
  @@index([timestamp])
}

model DeliveryStateHistory {
  id            String         @id @default(uuid())
  deliveryId    String
  delivery      Delivery       @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  previousState String?
  newState      DeliveryStatus
  actorId       String?
  reason        String?
  metadata      Json?
  timestamp     DateTime       @default(now())

  @@index([deliveryId, timestamp])
  @@index([timestamp])
}

model Consultation {
  id                 String             @id @default(uuid())
  customerId         String
  customer           User               @relation("CustomerConsultations", fields: [customerId], references: [id], onDelete: Restrict)
  pharmacistId       String?
  pharmacist         User?              @relation("PharmacistConsultations", fields: [pharmacistId], references: [id], onDelete: SetNull)
  pharmacyId         String?
  pharmacy           Pharmacy?          @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)
  status             ConsultationStatus @default(REQUESTED)
  symptoms           String
  duration           String
  age                Int
  currentMedications String?
  allergies          String?
  additionalDetails  String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  assignmentHistory ConsultationAssignmentHistory[]
  messages          ChatMessage[]

  @@index([customerId, status])
  @@index([pharmacistId, status])
  @@index([pharmacyId, status])
  @@index([status, createdAt])
}

model ConsultationAssignmentHistory {
  id               String       @id @default(uuid())
  consultationId   String
  consultation     Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  pharmacistId     String
  assignedByUserId String
  assignedByUser   User         @relation("AssignmentAssigner", fields: [assignedByUserId], references: [id], onDelete: Restrict)
  assignedAt       DateTime     @default(now())
  unassignedAt     DateTime?
  reason           String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([consultationId])
  @@index([pharmacistId])
}

model ChatMessage {
  id             String       @id @default(uuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Restrict)
  content        String
  createdAt      DateTime     @default(now())
  readAt         DateTime?

  @@index([consultationId, createdAt])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  metadata   Json?
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}



