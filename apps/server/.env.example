# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/shafaq"

# Delivery pricing
# These values are intentionally required before a pharmacy can finalize a quote.
SHAFAQ_PRICING_BASE_FEE=""
SHAFAQ_PRICING_PER_KM=""
SHAFAQ_PRICING_MAX_DISTANCE_KM=""
SHAFAQ_PRICING_VERSION="v1"
SHAFAQ_PRICING_CONFIGURATION_REF="shafaq-distance-pricing-v1"

# Private prescription storage
SHAFAQ_PRIVATE_STORAGE_PATH="./storage/private"
SHAFAQ_STORAGE_SIGNING_SECRET=""
SHAFAQ_PRESCRIPTION_SIGNED_URL_TTL_SECONDS="300"
SHAFAQ_PRESCRIPTION_MAX_BYTES="10485760"
